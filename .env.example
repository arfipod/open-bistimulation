# Copy this file to .env.local for local development.
# Any of these names can be used; VITE_* is recommended for local Vite usage.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Vercel + Supabase integration aliases (optional):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Local Joy-Con bridge only. These are read by `npm run joycon:bridge`
# on the therapist/operator computer, not by the Vercel frontend runtime.
# JOYCON_BRIDGE_HOST=127.0.0.1
# JOYCON_BRIDGE_PORT=5174
# JOYCON_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://open-bistimulation.vercel.app
