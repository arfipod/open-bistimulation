# Copy this file to .env.local for local development.
# Any of these names can be used; VITE_* is recommended for local Vite usage.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Vercel + Supabase integration aliases (optional):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Legacy Joy-Con bridge only. The app uses browser WebHID by default,
# so these are only read if you run `npm run joycon:bridge` for diagnostics.
# JOYCON_BRIDGE_HOST=127.0.0.1
# JOYCON_BRIDGE_PORT=5174
# JOYCON_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://open-bistimulation.vercel.app
