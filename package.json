{
  "name": "open-bistimulation",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Independent MVP web app for controller-guided browser-based bilateral sensory cues using React, TypeScript, Vite and Supabase Realtime.",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "joycon:bridge": "node scripts/joycon-bridge.mjs",
    "joycon:list": "node scripts/joycon-rumble.mjs list",
    "joycon:left": "node scripts/joycon-rumble.mjs pulse --side left --intensity high --duration 900 --repeats 2",
    "joycon:right": "node scripts/joycon-rumble.mjs pulse --side right --intensity high --duration 900 --repeats 2",
    "joycon:both": "node scripts/joycon-rumble.mjs pulse --side both --intensity high --duration 700 --repeats 1",
    "joycon:neutral": "node scripts/joycon-rumble.mjs neutral --side both",
    "stress": "node scripts/stress-test.mjs",
    "legal:check": "node scripts/legal-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "node-hid": "^3.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.7"
  }
}
